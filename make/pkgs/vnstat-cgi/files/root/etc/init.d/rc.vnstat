#!/bin/sh

[ -r /etc/options.cfg ] && . /etc/options.cfg
[ "$FREETZ_PACKAGE_VNSTAT_VERSION_ABANDON" == "y" ] && CONF_VER="vns1" || CONF_VER="vns2"

DAEMON=vnstat
DAEMON_BIN=vnstatd
DAEMON_LONG_NAME="vnStat"
DAEMON_CFGFILE=/tmp/flash/$DAEMON/$DAEMON.conf
. /etc/init.d/modlibrc

HTTPD_PID_VNS=/var/run/httpd_vns.pid

config_vns1() {
	if [ -z "$VNSTAT_INTERFACES" ]; then
		VNSTAT_INTERFACES="$(vnstat --iflist | sed 's/.*: //;s/ ([^)]*)//g')"
	else
		#delete unused databases
		for dbfile in $(ls -A /var/lib/vnstat/ 2>/dev/null); do
			useif="no"
			for ifname in $VNSTAT_INTERFACES; do
				[ "$ifname" = "$dbfile" ] && useif="yes"
				[ ".$ifname" = "$dbfile" ] && useif="yes"
			done
			if [ "$useif" = "no" ]; then
				rm -f /var/lib/vnstat/$dbfile
				rm -f /var/lib/vnstat/.$dbfile
			fi
		done
	fi

	#create new databeses
	for ifname in $VNSTAT_INTERFACES; do
		vnstat -u -i $ifname --config $DAEMON_CFGFILE >/dev/null
		if [ $? -ne 0 ]; then
			echo 'failed.'
			vnstat -u -i $ifname --config $DAEMON_CFGFILE
			echo 'Is your USB-device yet available?'
			exit 1
		fi
	done
}

config_vns2() {
	local dbiflist

	# initialize sqlite, maybe import old v1 databases, this also cleans dirty unmount
	if [ ! -e /var/lib/vnstat/vnstat.db ] || [ -e /var/lib/vnstat/vnstat.db-journal ]; then
		vnstatd --initdb --config "$DAEMON_CFGFILE"
	fi
	dbiflist="$(vnstat --dbiflist 1 --config "$DAEMON_CFGFILE")"

	# warn about old databases, should be imported
	if ls -A /var/lib/vnstat/ 2>/dev/null | grep -qv '^vnstat\.db'; then
		echo 'old unused v1 files detected in /var/lib/vnstat/ ...'
	fi

	if [ -z "$VNSTAT_INTERFACES" ]; then
		VNSTAT_INTERFACES="$(vnstat --iflist | sed 's/.*: //;s/ ([^)]*)//g')"
	else
		#delete unused database entries
		for dbnif in $dbiflist; do
			useif="no"
			for ifname in $VNSTAT_INTERFACES; do
				[ "$ifname" = "$dbnif" ] && useif="yes"
			done
			if [ "$useif" = "no" ]; then
				vnstat --remove --force -i "$dbnif" --config "$DAEMON_CFGFILE" >/dev/null || \
				vnstat --remove --force -i "$dbnif" --config "$DAEMON_CFGFILE"
			fi
		done
	fi

	#create new database entries
	for ifname in $VNSTAT_INTERFACES; do
		useif="no"
		for dbnif in $dbiflist; do
			[ "$ifname" = "$dbnif" ] && useif="yes"
		done
		[ "$useif" = "yes" ] && continue
		vnstat --add -i "$ifname" --config "$DAEMON_CFGFILE" >/dev/null || \
		vnstat --add -i "$ifname" --config "$DAEMON_CFGFILE"
	done

	# check existing database file
	if [ ! -s /var/lib/vnstat/vnstat.db ]; then
		echo 'failed.'
		echo 'Is your USB-device yet available?'
		exit 1
	fi
}

config() {
	local SUBDAEMON=vns
	modlib_config httpd-$SUBDAEMON /mod/etc/httpd-${SUBDAEMON}.conf

	mkdir "$VNSTAT_DBDIR" 2>/dev/null
	mkdir -p /var/lib
	rm -rf /var/lib/vnstat 2>/dev/null
	ln -s "$VNSTAT_DBDIR" /var/lib/vnstat

	config_$CONF_VER
}

stop_status() {
	kill -9 "$(cat $HTTPD_PID_VNS 2>/dev/null)" 2>/dev/null
	[ -x /mod/etc/init.d/rc.inetd ] && /mod/etc/init.d/rc.inetd config $DAEMON >/dev/null
	modunreg status $DAEMON stats
}

start() {
	stop_status
	if [ "$VNSTAT_WEBENABLED" = "yes" -a "$VNSTAT_WEB_INETD" != "yes" ]; then
		if [ "$VNSTAT_WEB_AUTH" = yes ]; then
			echo "/:$VNSTAT_WEB_USER:$(httpd -m $VNSTAT_WEB_PASS)" >/mod/etc/httpd-vns.conf
			VNS_CONF="-c /mod/etc/httpd-vns.conf"
		fi
		webcfg-vns -P $HTTPD_PID_VNS
	fi
	modlib_startdaemon $DAEMON_BIN -s -d --config $DAEMON_CFGFILE
	[ -x /mod/etc/init.d/rc.inetd ] && /mod/etc/init.d/rc.inetd config $DAEMON
	modreg status $DAEMON "$DAEMON_LONG_NAME" stats
}

stop_pre() {
	stop_status
}

case $1 in
	config)
		config
		;;
	""|load)
		modlib_add_httpd_symlink vns

		[ ! -d "/tmp/flash/vnstat" ] && mkdir -p /tmp/flash/vnstat
		[ ! -L "$DAEMON_CFGFILE" ] && [ -s "$DAEMON_CFGFILE" ] && mv "$DAEMON_CFGFILE" "/tmp/flash/vnstat/vnstat-vns1.conf"  # compat
		ln -sf "vnstat-$CONF_VER.conf" "$DAEMON_CFGFILE"
		[ ! -e "$DAEMON_CFGFILE" ] && "/mod/etc/default.vnstat/vnstat_$CONF_VER" > "$DAEMON_CFGFILE"

		modreg file $DAEMON conf 'vnstat.conf' 1 "vnstat_conf"
		modreg cgi $DAEMON "$DAEMON_LONG_NAME"
		modreg daemon $DAEMON

		modlib_start $VNSTAT_ENABLED
		;;
	unload)
		modunreg daemon $DAEMON
		modunreg cgi $DAEMON
		modunreg file $DAEMON
		modlib_stop
		;;
	start)
		modlib_start
		;;
	stop)
		modlib_stop
		;;
	restart)
		modlib_restart
		;;
	status)
		modlib_status
		;;
	status_webcfg-vns)
		[ "$VNSTAT_WEBENABLED" = "yes" -a "$VNSTAT_WEB_INETD" = "yes" -a "$(modlib_status)" == "running" ] && echo 'inetd' || modlib_status
		;;
	*)
		echo "Usage: $0 [load|unload|start|stop|restart|status|config]" 1>&2
		exit 1
		;;
esac

exit 0
