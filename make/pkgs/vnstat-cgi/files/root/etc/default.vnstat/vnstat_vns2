#!/bin/sh

cat <<EOF
# vnStat 2.13 config file
##

# default interface (empty = automatic selection for database queries)
Interface "fritzbox"

### The DatabaseDir should NOT be changed here, use the Freetz-Webinterface!

# location of the database directory
DatabaseDir "/var/lib/vnstat"

# locale (LC_ALL) ("-" = use system locale)
Locale "-"

# on which day should months change
MonthRotate 1

# date output formats for days, months and top days
# see 'man date' for control codes
DayFormat    "%x"
MonthFormat  "%b '%y"
TopFormat    "%x"

# characters used for visuals
RXCharacter       "%"
TXCharacter       ":"
RXHourCharacter   "r"
TXHourCharacter   "t"

# how units are prefixed when traffic is shown
# 0 = IEC standard prefixes (KiB/MiB/GiB/TiB)
# 1 = old style binary prefixes (KB/MB/GB/TB)
UnitMode 1

# output style
# 0 = minimal & narrow, 1 = bar column visible
# 2 = same as 1 except rate in summary
# 3 = rate column visible
OutputStyle 3

# used rate unit (0 = bytes, 1 = bits)
RateUnit 1

# maximum bandwidth (Mbit) for all interfaces, 0 = disable feature
# (unless interface specific limit is given)
MaxBandwidth 100

# interface specific limits
#  example 8Mbit limit for eth0 (remove # to activate):
#MaxBWeth0 8

# how many seconds should sampling for -tr take by default
Sampletime 5

# default query mode
# 0 = summary, 1 = days, 2 = months, 3 = top, 4 = single summary
# 5 = short, 6 = years, 7 = hours graph, 8 = xml, 9 = one line
# 10 = json, 11 = hours, 12 = 5 minute
QueryMode 0

### You have to set CheckDiskSpace to 0 if you would like to save your databases to /tmp/!

# filesystem disk space check (1 = enabled, 0 = disabled)
CheckDiskSpace 0

# how much the boot time can variate between updates (seconds)
BootVariation 15

# log time periods without traffic (1 = enabled, 0 = disabled)
TrafficlessEntries 1

# default list lengths (0 = all available entries)
List5Mins 24
ListHours 24
ListDays 30
ListMonths 12
ListYears 0
ListTop 10


# vnstatd
##

# data retention (-1 = unlimited, 0 = disabled)
#5MinuteHours 48
5MinuteHours 0
HourlyDays 4
DailyDays 62
MonthlyMonths 25
YearlyYears -1
TopDayEntries 20

# interfaces are managed by Freetz!
AlwaysAddNewInterfaces 0
RescanDatabaseOnSave 1

# how often (in seconds) interface data is updated
UpdateInterval 60

# how often (in seconds) interface status changes are checked
PollInterval 30

# how often (in minutes) data is saved to file
SaveInterval 30

# how often (in minutes) data is saved when all interface are offline
OfflineSaveInterval 30

# force data save when interface status changes (1 = enabled, 0 = disabled)
SaveOnStatusChange 1

# enable / disable logging (0 = disabled, 1 = logfile, 2 = syslog)
UseLogging 2

# file used for logging if UseLogging is set to 1
LogFile "/var/log/vnstat.log"

# file used as daemon pid / lock file
PidFile "/var/run/vnstatd.pid"


# vnstati
##

# title timestamp format
HeaderFormat "%x %H:%M"

# show hours with rate (1 = enabled, 0 = disabled)
HourlyRate 1

# show rate in summary (1 = enabled, 0 = disabled)
SummaryRate 1

# 5 minute graph (12 entries per hour; 576 = 48 hours)
5MinuteGraphResultCount 576
5MinuteGraphHeight 200

# hourly graph (0 = sliding 24 hours, 1 = start from midnight)
HourlyGraphMode 0

# transparent background (1 = enabled, 0 = disabled)
TransparentBg 0

# image colors
CBackground     "FFFFFF"
CEdge           "AEAEAE"
CHeader         "606060"
CHeaderTitle    "FFFFFF"
CHeaderDate     "FFFFFF"
CText           "000000"
CLine           "B0B0B0"
CLineL          "-"
CRx             "92CF00"
CTx             "606060"
CRxD            "-"
CTxD            "-"
EOF
