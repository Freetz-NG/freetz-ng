+
+_voicemail_claim() {
+    _voicemail_bind "$1" "$2" && mkdir "${1%/*}/seen/$2" 2>/dev/null
+}
+
+_voicemail_recording_path() {
+    local path=$1 root canonical
+    local directory="${CALLMONITOR_VOICEMAIL_DIR:-/data/tam/rec}"
+    case $path in
+        /download.lua\?path=*|download.lua\?path=*) path=${path#*\?path=} ;;
+    esac
+    path=${path%%&*}
+    case ${path##*/} in rec.[0-9].[0-9][0-9][0-9]) ;; *) return 1 ;; esac
+    root=$(realpath "$directory") || return 1
+    canonical=$(realpath "$path" 2>/dev/null) || return 1
+    [ "$canonical" = "$root/${path##*/}" ] && [ -f "$canonical" ] || return 1
+    printf '%s\n' "$directory/${path##*/}"
+}
+
+_voicemail_capture() (
+    local context=$1 row=$2 since=$3
+    local id port caller called when mailbox path caller_name recording signature mtime
+    local archive base index other other_path matches=0
+    IFS='|' read -r id port caller called when mailbox path caller_name <<EOF_ROW
+$row
+EOF_ROW
+    [ -n "$id" ] && [ -n "$when" ] || exit 1
+    recording=$(_voicemail_recording_path "$path") || exit 1
+    signature=$(stat -c '%i:%s:%Y' "$recording") || exit 1
+    mtime=${signature##*:}
+    [ "$mtime" -ge "$since" ] || exit 1
+
+    archive=$(mktemp -d "$context/audio.XXXXXX") || exit 1
+    trap 'rm -rf "$archive"' EXIT
+    base=${recording##*/}
+    cp "$recording" "$archive/$base" || exit 1
+    [ -s "$archive/$base" ] || exit 1
+    /usr/bin/tam_play "$recording" > "$archive/Anrufbeantworter.wav" || exit 1
+    [ "$(head -c 4 "$archive/Anrufbeantworter.wav")" = RIFF ] &&
+        [ "$(dd if="$archive/Anrufbeantworter.wav" bs=1 skip=8 count=4 2>/dev/null)" = WAVE ] || exit 1
+    # Confirm the same call-list row and original audio after conversion.
+    _voicemail_fetch > "$archive/confirm" || exit 1
+    while IFS= read -r other; do
+        if [ "${other%%|*}" = "$id" ] && [ "$other" != "$row" ]; then
+            exit 1
+        fi
+        other_path=$(printf '%s\n' "$other" | cut -d '|' -f 7)
+        case ${other_path%%&*} in */"$base") ;; *) continue ;; esac
+        [ "$(_voicemail_recording_path "$other_path")" = "$recording" ] || continue
+        [ "$other" = "$row" ] || exit 1
+        matches=$((matches + 1))
+    done < "$archive/confirm"
+    [ "$matches" -eq 1 ] || exit 1
+    [ "$(stat -c '%i:%s:%Y' "$recording")" = "$signature" ] || exit 1
+    cmp -s "$recording" "$archive/$base" || exit 1
+    _voicemail_claim "$context" "$id" || exit 1
+    : > "$context/recording-found"
+
+    index=${base#rec.}
+    index=${index%%.*}
+    local EVENT=in:voicemail ID UUID SOURCE=$caller DEST=$called EXT=$port
+    local TIMESTAMP=$when SOURCE_OPTIONS= DEST_OPTIONS=--local PROVIDER= DURATION=
+    local VOICEMAIL_CALL_LIST_ID=$id
+    IFS='|' read -r ID UUID < "$context/identity" || exit 1
+    local VOICEMAIL_RECORDING="$archive/Anrufbeantworter.wav" VOICEMAIL_MAILBOX_INDEX=$index
+    local VOICEMAIL_MAILBOX_NAME="${mailbox:-Anrufbeantworter $((index + 1))}"
+    local VOICEMAIL_CALLER_NAME=$caller_name
+    local VOICEMAIL_ORIGINAL=$recording VOICEMAIL_COMPARISON="$archive/$base"
+    export VOICEMAIL_RECORDING VOICEMAIL_MAILBOX_INDEX VOICEMAIL_MAILBOX_NAME VOICEMAIL_CALLER_NAME
+    export VOICEMAIL_ORIGINAL VOICEMAIL_COMPARISON VOICEMAIL_CALL_LIST_ID
+    incoming_call
+    exit $?
+)
+
+_voicemail_dispatch_empty() (
+    local context=$1 row=$2 id port caller called when mailbox path caller_name
+    IFS='|' read -r id port caller called when mailbox path caller_name <<EOF_ROW
+$row
+EOF_ROW
+    [ -z "$path" ] && _voicemail_claim "$context" "$id" || exit 1
+    local EVENT=in:voicemail-empty ID UUID SOURCE=$caller DEST=$called EXT=$port
+    local TIMESTAMP=$when SOURCE_OPTIONS= DEST_OPTIONS=--local PROVIDER= DURATION=
+    local VOICEMAIL_MAILBOX_NAME="${mailbox:-Anrufbeantworter}" VOICEMAIL_CALLER_NAME=$caller_name
+    local VOICEMAIL_CALL_LIST_ID=$id
+    IFS='|' read -r ID UUID < "$context/identity" || exit 1
+    export VOICEMAIL_MAILBOX_NAME VOICEMAIL_CALLER_NAME VOICEMAIL_CALL_LIST_ID
+    incoming_call
+)
+
+_voicemail_dispatch() (
+    local context=$1 run=${1%/*} since row previous= id bound= early_previous= fallback=
+    local started now deadline timeout fresh=
+    trap 'rm -rf "$context"' EXIT
+    read -r since < "$context/since" || exit 0
+    [ ! -f "$context/observed/before.ids" ] || fresh="$context/observed/before.ids"
+    # During a cold start, use the call's own snapshot or an active ID.
+    [ -f "$context/baseline.ids" ] || fallback=$fresh
+    started=$(date +%s)
+    deadline=$((started + 10))
+    timeout=$((started + 20))
+    while :; do
+        bound=$(readlink "$context/resolution" 2>/dev/null) || bound=
+        [ "$bound" != ambiguous ] || exit 0
+        [ -z "$bound" ] || fallback=
+        now=$(date +%s)
+        row=
+        id=
+        if _voicemail_fetch calls "$run" > "$context/current"; then
+            if [ -z "$bound" ] && [ -n "$fresh" ] && [ "$now" -lt "$deadline" ]; then
+                row=$(_voicemail_candidate "$context" "" "$fresh" < "$context/current") || row=
+                id=${row%%|*}
+                if [ -n "$id" ] && [ "$id" = "$early_previous" ] && _voicemail_bind "$context" "$id"; then
+                    bound=$id
+                    fallback=
+                else
+                    row=
+                fi
+            fi
+            if [ -z "$row" ] && { [ -n "$bound$fallback" ] || [ -f "$context/baseline.ids" ]; }; then
+                row=$(_voicemail_candidate "$context" "$bound" "$fallback" < "$context/current") || row=
+            fi
+            if [ -n "$row" ] && [ "$row" = "$previous" ]; then
+                _voicemail_capture "$context" "$row" "$since" || :
+                [ ! -e "$context/recording-found" ] || exit 0
+                if [ "$now" -ge "$deadline" ]; then
+                    if _voicemail_dispatch_empty "$context" "$row"; then
+                        exit 0
+                    fi
+                fi
+            fi
+        fi
+        [ "$now" -lt "$timeout" ] || exit 0
+        early_previous=$id
+        previous=$row
+        if [ -z "$bound" ] && [ -n "$fresh" ] && [ "$now" -lt "$((started + 4))" ]; then
+            _voicemail_pause
+        else
+            sleep 1
+        fi
+    done
+)
+
+_voicemail_delete_after_send() (
+    local index=$VOICEMAIL_MAILBOX_INDEX message_index= id tam number when path
+    local counter=0 rows
+    rows=$(_voicemail_messages "$index") || exit 1
+    while IFS='|' read -r id tam number when path; do
+        [ "$tam" = "$index" ] && [ "$number" = "$SOURCE" ] && [ "$when" = "$TIMESTAMP" ] || continue
+        [ "$(_voicemail_recording_path "$path")" = "$VOICEMAIL_ORIGINAL" ] || continue
+        message_index=$id
+        counter=$((counter + 1))
+    done <<EOF_ROWS
+$rows
+EOF_ROWS
+    [ "$counter" -eq 1 ] && cmp -s "$VOICEMAIL_ORIGINAL" "$VOICEMAIL_COMPARISON" || exit 1
+    _voicemail_soap X_AVM-DE_TAM x_tam DeleteMessage \
+        "<NewIndex>$index</NewIndex><NewMessageIndex>$message_index</NewMessageIndex>" > /dev/null
+)
+
+voicemailmail() (
+    local work wav attachment format=wav mailbox caller caller_name
+    local delete=no send=send inline=- status subject intro
+    local VOICEMAIL_ATTACH_AUDIO=yes
+    while [ "$#" -gt 0 ]; do
+        case $1 in
+            --mp3) format=mp3; shift ;;
+            --no-attachment) VOICEMAIL_ATTACH_AUDIO=no; shift ;;
+            --delete-after-send) delete=yes; shift ;;
+            *) break ;;
+        esac
+    done
+    case $EVENT in
+        in:voicemail) [ -s "${VOICEMAIL_RECORDING:-}" ] || exit 1 ;;
+        in:voicemail-empty) VOICEMAIL_ATTACH_AUDIO=no; delete=no ;;
+        *) exit 1 ;;
+    esac
+    [ "${VOICEMAIL_TEST:-}" != yes ] || delete=no
+    wav=${VOICEMAIL_RECORDING:-}
+    mailbox=${VOICEMAIL_MAILBOX_NAME:-Anrufbeantworter}
+    caller=${SOURCE:-Unbekannt}
+    caller_name=${VOICEMAIL_CALLER_NAME:-}
+    attachment=$wav
+    [ "$VOICEMAIL_ATTACH_AUDIO" = yes ] || attachment=
+    subject="Neue Nachricht auf $mailbox"
+    intro="Neue Nachricht auf $mailbox."
+    if [ "$EVENT" = in:voicemail-empty ]; then
+        attachment=
+        subject='Keine Nachricht hinterlassen'
+        intro="$mailbox hat den Anruf angenommen. Es wurde keine Nachricht hinterlassen."
+    fi
+    umask 077
+    work=$(mktemp -d /var/tmp/callmonitor-voicemail.XXXXXX) || exit 1
+    voicemail_mail_cleanup=$work
+    trap 'rm -rf "$voicemail_mail_cleanup"' EXIT
+    if [ -n "$attachment" ] && [ "$format" = mp3 ] && command -v lame >/dev/null 2>&1; then
+        if lame --quiet -m m -b 32 "$wav" "$work/Anrufbeantworter.mp3" &&
+            [ -s "$work/Anrufbeantworter.mp3" ]; then
+            attachment="$work/Anrufbeantworter.mp3"
+        fi
+    fi
+    if [ -n "${CALLMONITOR_VOICEMAIL_TEMPLATE:-}" ]; then
+        "$CALLMONITOR_VOICEMAIL_TEMPLATE" > "$work/nachricht.html" || exit 1
+        inline="-,$work/nachricht.html"
+    fi
+    [ "$delete" = no ] || send=sendchecked
+    [ -z "$attachment" ] || set -- -d "$attachment" "$@"
+    {
+        printf '%s\n\n' "$intro"
+        printf 'Rufnummer: %s\n' "$caller"
+        [ -z "$caller_name" ] || printf 'Name: %s\n' "$caller_name"
+        printf 'Datum und Uhrzeit: %s\n' "$TIMESTAMP"
+    } | mail "$send" -s "$subject: $caller" -i "$inline" "$@"
+    status=$?
+    [ "$status" -eq 0 ] || exit "$status"
+    if [ "$delete" = yes ]; then
+        _voicemail_delete_after_send || exit 1
+    fi
+    exit 0
+)
