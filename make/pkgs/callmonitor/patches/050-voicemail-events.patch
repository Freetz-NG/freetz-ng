--- /dev/null
+++ base/usr/lib/callmonitor/modules/voicemail.sh
@@ -0,0 +1,463 @@
+require user
+
+# AVM TR-064 OnTel, section 5.2, identifies ports 6 and 40-49 as TAM ports.
+_voicemail_is_tam_port() {
+    case $1 in
+        6|4[0-9]) return 0 ;;
+        *) return 1 ;;
+    esac
+}
+
+_voicemail_http() {
+    local netrc="${CALLMONITOR_VOICEMAIL_NETRC:-/tmp/flash/callmonitor/voicemail.netrc}"
+    local username=${CALLMONITOR_USERNAME:-} password=${CALLMONITOR_PASSWORD:-} credentials
+    if [ -n "${CALLMONITOR_VOICEMAIL_NETRC:-}" ] || [ -z "$username" ]; then
+        [ -s "$netrc" ] || return 1
+        curl -q --noproxy '*' --globoff -fsS --max-time 4 --digest --netrc-file "$netrc" "$@"
+        return
+    fi
+    [ -n "$password" ] || password=$(user_getpw "$username") || return 1
+    [ -n "$password" ] || return 1
+    case $username:$password in
+        *'
+'*) return 1 ;;
+    esac
+    credentials=$(printf '%s:%s' "$username" "$password" | sed 's/[\\"]/\\&/g')
+    printf 'user = "%s"\n' "$credentials" |
+        curl -q --config - --noproxy '*' --globoff -fsS --max-time 4 --digest "$@"
+}
+
+_voicemail_soap_post() {
+    local url=$1 action=$2 body=$3
+    printf '%s' "$body" | curl -q --noproxy '*' --globoff -sS --max-time 4 \
+        -H 'Content-Type: text/xml; charset=utf-8' -H "SOAPAction: \"$action\"" \
+        --data-binary @- "$url"
+}
+
+_voicemail_soap() {
+    local service=$1 route=$2 method=$3 args=$4
+    local urn="urn:dslforum-org:service:$service:1"
+    local url="http://127.0.0.1:49000/upnp/control/$route"
+    local envelope='<s:Envelope xmlns:s="http://schemas.xmlsoap.org/soap/envelope/" s:encodingStyle="http://schemas.xmlsoap.org/soap/encoding/">'
+    local body="<s:Body><u:$method xmlns:u=\"$urn\">$args</u:$method></s:Body></s:Envelope>"
+    local username=${CALLMONITOR_USERNAME:-} password=${CALLMONITOR_PASSWORD:-}
+    local user_xml ns challenge nonce realm secret auth response
+    if [ -z "$username" ] || [ -n "${CALLMONITOR_VOICEMAIL_NETRC:-}" ]; then
+        _voicemail_http -H 'Content-Type: text/xml; charset=utf-8' \
+            -H "SOAPAction: \"$urn#$method\"" --data-binary "$envelope$body" "$url"
+        return
+    fi
+    [ -n "$password" ] || password=$(user_getpw "$username") || return 1
+    [ -n "$password" ] || return 1
+    user_xml=$(printf '%s' "$username" | sed 's/\&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g')
+    ns='xmlns:h="http://soap-authentication.org/digest/2001/10/" s:mustUnderstand="1"'
+    challenge=$(_voicemail_soap_post "$url" "$urn#$method" \
+        "$envelope<s:Header><h:InitChallenge $ns><UserID>$user_xml</UserID></h:InitChallenge></s:Header>$body") || return 1
+    nonce=$(printf '%s' "$challenge" | sed -n 's/.*<Nonce>\([[:xdigit:]]\{1,128\}\)<\/Nonce>.*/\1/p')
+    realm=$(printf '%s' "$challenge" | sed -n 's/.*<Realm>\([^<]*\)<\/Realm>.*/\1/p')
+    [ -n "$nonce" ] && [ "$realm" = 'F!Box SOAP-Auth' ] || return 1
+    secret=$(printf '%s' "$username:$realm:$password" | md5sum) || return 1
+    auth=$(printf '%s' "${secret%% *}:$nonce" | md5sum) || return 1
+    response=$(_voicemail_soap_post "$url" "$urn#$method" \
+        "$envelope<s:Header><h:ClientAuth $ns><Nonce>$nonce</Nonce><Auth>${auth%% *}</Auth><UserID>$user_xml</UserID><Realm>$realm</Realm></h:ClientAuth></s:Header>$body") || return 1
+    case $response in *"<u:${method}Response"*|*"<${method}Response"*) printf '%s\n' "$response" ;; *) return 1 ;; esac
+}
+
+_voicemail_list_uri() {
+    local uri=${2#*://}
+    uri=/${uri#*/}
+    case $uri in /"$1"\?*) printf '%s\n' "$uri" ;; *) return 1 ;; esac
+}
+
+_voicemail_messages() (
+    set -o pipefail
+    local parser="$CALLMONITOR_LIBDIR/bin/voicemail-xml" url uri
+    url=$(_voicemail_soap X_AVM-DE_TAM x_tam GetMessageList "<NewIndex>$1</NewIndex>" |
+        "$parser" tam-url) || exit 1
+    uri=$(_voicemail_list_uri tamcalllist.lua "$url") || exit 1
+    _voicemail_http "http://127.0.0.1:49000$uri" | "$parser" messages
+)
+
+# Reuse the authorized URL until it fails, then refresh it.
+_voicemail_fetch() (
+    set -o pipefail
+    local parser="$CALLMONITOR_LIBDIR/bin/voicemail-xml" mode=${1:-calls}
+    local run=${2:-} url uri response cache
+    [ -x "$parser" ] || exit 1
+    if [ -z "$run" ] || ! read -r uri 2>/dev/null < "$run/list-uri" ||
+        ! response=$(_voicemail_http "http://127.0.0.1:49000$uri"); then
+        url=$(_voicemail_soap X_AVM-DE_OnTel x_contact GetCallList '' | "$parser" url) || exit 1
+        uri=$(_voicemail_list_uri calllist.lua "$url") || exit 1
+        response=$(_voicemail_http "http://127.0.0.1:49000$uri") || exit 1
+        if [ -n "$run" ] && cache=$(mktemp "$run/list-uri.XXXXXX"); then
+            printf '%s\n' "$uri" > "$cache" && mv "$cache" "$run/list-uri"
+            rm -f "$cache"
+        fi
+    fi
+    printf '%s\n' "$response" | "$parser" "$mode"
+)
+
+_voicemail_pause() {
+    usleep 250000 2>/dev/null || sleep 1
+}
+
+# A slow or unavailable TR-064 service must not delay the call stream.
+_voicemail_prepare() (
+    local run
+    run=$(mktemp -d /var/run/callmonitor/voicemail.XXXXXX) || exit 1
+    if ! mkdir "$run/seen" "$run/reserved"; then
+        rm -rf "$run"
+        exit 1
+    fi
+    _voicemail_init_baseline "$run" </dev/null >/dev/null 2>&1 &
+    printf '%s\n' "$run"
+)
+
+_voicemail_init_baseline() {
+    [ -f "$1/before.ids" ] || _voicemail_snapshot "$1" "$1" || [ -f "$1/before.ids" ]
+}
+
+# Publish a complete list only while the destination directory is open.
+_voicemail_snapshot() (
+    local run=$1 dest=$2 snapshot
+    snapshot=$(mktemp -d "$run/snapshot.XXXXXX") || exit 1
+    trap 'rm -rf "$snapshot"' EXIT
+    _voicemail_fetch calls "$run" > "$snapshot/rows" || exit 1
+    cut -d '|' -f 1 "$snapshot/rows" > "$snapshot/ids" || exit 1
+    ln "$snapshot/ids" "$dest/before.ids"
+)
+
+_voicemail_start_ring() (
+    local run=$1 ring
+    ring=$(mktemp -d "$run/ring.XXXXXX") || exit 1
+    _voicemail_snapshot "$run" "$ring" </dev/null >/dev/null 2>&1 &
+    printf '%s\n' "$ring"
+)
+
+_voicemail_begin() {
+    local run=$1 ring=${9:-} context match other baseline="$1/before.ids"
+    context=$(mktemp -d "$run/call.XXXXXX") || return 1
+    match="$2|$3|$4"
+    if ! { printf '%s\n' "$match" > "$context/connection" &&
+        printf '%s\n' "$5" "$6" > "$context/minutes" &&
+        printf '%s|%s\n' "$7" "$8" > "$context/identity" &&
+        date +%s > "$context/since"; }; then
+        rm -rf "$context"
+        return 1
+    fi
+    if [ -n "$ring" ] && [ -f "$ring/before.ids" ]; then
+        baseline="$ring/before.ids"
+    fi
+    if [ -f "$baseline" ]; then
+        ln "$baseline" "$context/baseline.ids" 2>/dev/null || :
+    fi
+    for other in "$run"/call.*/connection; do
+        [ "$other" != "$context/connection" ] || continue
+        if grep -Fqx -- "$match" "$other" 2>/dev/null; then
+            # A claim and a conflict compete for the same state. A call
+            # that already owns its row may still be sending mail.
+            if ln -s ambiguous "${other%/*}/resolution" 2>/dev/null ||
+                [ "$(readlink "${other%/*}/resolution")" = ambiguous ]; then
+                ln -s ambiguous "$context/resolution" 2>/dev/null || :
+            fi
+        fi
+    done
+    voicemail_context=$context
+    if [ ! -L "$context/resolution" ] && mkdir "$context/observing"; then
+        if [ -n "$ring" ] && [ -f "$ring/before.ids" ]; then
+            ln "$ring/before.ids" "$context/observing/before.ids" 2>/dev/null || :
+        fi
+        _voicemail_track_active "$context" </dev/null >/dev/null 2>&1 &
+    fi
+}
+
+# Closing the observation directory at DISCONNECT freezes the result. A
+# request that completes after hang-up cannot bind the next active call.
+_voicemail_track_active() (
+    set -o pipefail
+    local context=$1 run=${1%/*} row attempt=0
+    if [ ! -f "$context/observing/before.ids" ]; then
+        _voicemail_snapshot "$run" "$context/observing" || :
+    fi
+    while [ "$attempt" -lt 24 ] && [ -d "$context/observing" ] &&
+        [ ! -L "$context/resolution" ]; do
+        if row=$(_voicemail_fetch active-calls "$run" | _voicemail_candidate "$context"); then
+            ln -s "${row%%|*}" "$context/observing/id"
+            exit $?
+        fi
+        attempt=$((attempt + 1))
+        _voicemail_pause
+    done
+)
+
+_voicemail_stop_tracking() {
+    local bound
+    [ -d "$1/observing" ] || return 0
+    mv "$1/observing" "$1/observed" || return 1
+    if bound=$(readlink "$1/observed/id" 2>/dev/null); then
+        _voicemail_bind "$1" "$bound"
+    fi
+}
+
+# FRITZ!OS can list the call in the answering minute instead of the
+# ringing minute. Only accept minutes observed on this connection.
+_voicemail_candidate() (
+    local context=$1 active_id=${2:-} fresh=${3:-} run=${1%/*} row id port caller called when rest candidate= owner
+    local match_port match_caller match_called
+    [ "$(readlink "$context/resolution" 2>/dev/null)" != ambiguous ] || exit 1
+    IFS='|' read -r match_port match_caller match_called < "$context/connection" || exit 1
+    [ -n "$match_called" ] || exit 1
+    while IFS= read -r row; do
+        IFS='|' read -r id port caller called when rest <<EOF_ROW
+$row
+EOF_ROW
+        [ -z "$active_id" ] || [ "$id" = "$active_id" ] || continue
+        [ "$port" = "$match_port" ] && [ "$caller" = "$match_caller" ] &&
+            [ "$called" = "$match_called" ] || continue
+        grep -Fqx -- "$when" "$context/minutes" || continue
+        [ ! -d "$run/seen/$id" ] || continue
+        if [ -f "$context/baseline.ids" ] && grep -Fqx "$id" "$context/baseline.ids"; then continue; fi
+        if [ -n "$fresh" ] && grep -Fqx "$id" "$fresh"; then continue; fi
+        if owner=$(readlink "$run/reserved/$id" 2>/dev/null) && [ "$owner" != "$context/identity" ]; then
+            continue
+        fi
+        [ -z "$candidate" ] || exit 1
+        candidate=$row
+    done
+    [ -n "$candidate" ] && printf '%s\n' "$candidate"
+)
+
+# Bind an ID before waiting for the attachment. The reservation is kept
+# for this run so later calls cannot take an ID that already had an owner.
+_voicemail_bind() {
+    local context=$1 id=$2 owner="${1%/*}/reserved/$2"
+    [ "$(readlink "$context/resolution" 2>/dev/null)" != ambiguous ] || return 1
+    if ! ln -s "$context/identity" "$owner" 2>/dev/null; then
+        [ "$(readlink "$owner" 2>/dev/null)" = "$context/identity" ] || return 1
+    fi
+    if ln -s "$id" "$context/resolution" 2>/dev/null ||
+        [ "$(readlink "$context/resolution" 2>/dev/null)" = "$id" ]; then
+        return 0
+    fi
+    rm -f "$owner"
+    return 1
