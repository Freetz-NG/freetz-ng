--- base/usr/lib/callmonitor/reverse/parse.awk
+++ base/usr/lib/callmonitor/reverse/parse.awk
@@ -0,0 +1,104 @@
+# Split markup using '<' as the record separator. Only match phone numbers
+# inside the same listing as the returned name and address.
+function attr(tag, key,    value) {
+    if (!match(tolower(tag), "[[:space:]]" tolower(key) "=[^[:space:]]"))
+        return ""
+    value = substr(tag, RSTART + RLENGTH - 1)
+    if (substr(value, 1, 1) == "\"" || substr(value, 1, 1) == "'") {
+        split(value, parts, substr(value, 1, 1))
+        return parts[2]
+    }
+    sub(/[[:space:]].*$/, "", value)
+    return value
+}
+
+function digits(value) {
+    gsub(/[^0-9]/, "", value)
+    if (substr(value, 1, 2) == "00")
+        return substr(value, 3)
+    if (substr(value, 1, 1) == "0")
+        return country substr(value, 2)
+    return value
+}
+
+function finish() {
+    if (matched && (name != "" || given != "" || family != "")) {
+        if (name == "") name = given " " family
+        print name "; " (address != "" ? address : street " " zip " " locality)
+        found = 1
+        exit
+    }
+    name = given = family = street = zip = locality = address = capture = ""
+    matched = 0
+}
+
+BEGIN { RS = "<"; target = digits(number) }
+
+{
+    end = index($0, ">")
+    if (!end) next
+    tag = substr($0, 1, end - 1)
+    body = substr($0, end + 1)
+    gsub(/[[:space:]]+/, " ", body)
+    prop = tolower(attr(tag, "itemprop"))
+    class = attr(tag, "class")
+    href = attr(tag, "href")
+    content = attr(tag, "content")
+
+    if (provider == "search_ch") {
+        if (tag ~ /^article / && class ~ /(^| )tel-resultentry( |$)/) {
+            finish()
+            listing = "article"
+        }
+        if (tag ~ /^section / && class ~ /(^| )tel-detail-title( |$)/) {
+            finish()
+            listing = "detail"
+        }
+        if (listing == "") next
+        if (listing == "article" && tag ~ /^\/article([[:space:]]|$)/ ||
+            listing == "detail" && tag ~ /^\/section([[:space:]]|$)/) {
+            finish()
+            listing = ""
+            next
+        }
+        if (listing == "detail" && tag ~ /^h1([[:space:]]|$)/) name = body
+        if (class == "tel-result-detail-link") name = attr(tag, "title")
+        if (class == "tel-address" || class == "street-address") street = body
+        if (class == "postal-code") zip = body
+        if (class == "locality") locality = body
+        if ((class ~ /(^| )tel-callable( |$)/ ||
+             listing == "detail" && class == "sl-icon-call") &&
+            href ~ /^tel:/ && digits(href) == target)
+            matched = 1
+        next
+    }
+
+    if (provider == "telefonbuch" && attr(tag, "id") ~ /^entry_[0-9]+$/ ||
+        provider == "herold_at" && tag ~ /^li / && prop == "itemlistelement" ||
+        provider == "telefonbuch_at" && tag ~ /^article / && class ~ /search-result/)
+        finish()
+
+    if (capture == "schnelle-name" && tag ~ /^\/h3/) capture = ""
+    if (capture == "address" && tag ~ /^\/p/) capture = ""
+
+    if (prop == "name" && name == "") name = content != "" ? content : body
+    if (prop == "givenname") given = content
+    if (prop == "familyname") family = content
+    if (prop == "streetaddress") street = body
+    if (prop == "postalcode") zip = body
+    if (prop == "addresslocality") locality = body
+    if (provider == "telefonbuch_at" && tag ~ /^h3 /) capture = "schnelle-name"
+    if (prop == "address" && provider == "herold_at" || class == "adresse")
+        capture = "address"
+    if (capture == "schnelle-name" && tag ~ /^a /) name = body
+    if (capture == "address" && class == "hidden") capture = ""
+    if (capture == "address") address = address " " body
+
+    if (provider == "telefonbuch" && tag ~ /^!-- phoneTo:/ && digits(tag) == target)
+        matched = 1
+    if ((prop == "telephone" && (digits(body) == target || digits(content) == target)) ||
+        (href ~ /^tel:/ && digits(href) == target))
+        matched = 1
+}
+
+END { if (!found) finish() }
--- base/usr/lib/callmonitor/reverse/parse.jq
+++ base/usr/lib/callmonitor/reverse/parse.jq
@@ -0,0 +1,24 @@
+def normalize:
+    gsub("[^0-9]"; "")
+    | if startswith("00") then .[2:]
+      elif startswith("0") then $country + .[1:]
+      else . end;
+
+def matches($phones):
+    any($phones[]; type == "string" and normalize == ($number | normalize));
+
+def display($name; $street; $zip; $city):
+    [$name, ";", $street, $zip, $city] | map(select(type == "string")) | join(" ");
+
+if $mode == "schema" then
+    fromjson? | .. | objects
+    | select((.name | type) == "string" and (.address | type) == "object")
+    | select(matches([.telephone | arrays[] , strings]))
+    | display(.name; .address.streetAddress; .address.postalCode; .address.addressLocality)
+else
+    fromjson? | .[1] | strings | split("\n")[]
+    | sub("^[0-9a-f]+:"; "") | fromjson?
+    | .. | objects | select(.__typename == "Entry" and (.title | type) == "string")
+    | select(matches([.contacts[]? | select(.__typename == "CustomerProvidedPhoneContact") | .value]))
+    | display(.title; .address.streetLine; .address.zipCode; .address.city)
+end
