#!/bin/sh

DAEMON=stunnel
DAEMON_LONG_NAME="Stunnel"
. /etc/init.d/modlibrc

config() {
	modlib_config
	if [ -r "/tmp/flash/stunnel/svcs" ]; then
		grep -q '#EXCLUSIVE#' "/tmp/flash/stunnel/svcs" && APPEND='' || APPEND='-a'
		cat /tmp/flash/stunnel/svcs | tee $APPEND $DAEMON_CONFIG >/dev/null
	fi
}

start() {
	modlib_startdaemon $DAEMON $DAEMON_CONFIG
}

case $1 in
	""|load)
		[ ! -d "/tmp/flash/stunnel" ] && mkdir -p /tmp/flash/stunnel
		[ ! -e "/tmp/flash/stunnel/svcs" ] && cat /mod/etc/default.stunnel/stunnel.defaults > /tmp/flash/stunnel/svcs 2>/dev/null

		modreg cgi $DAEMON "$DAEMON_LONG_NAME"
		modreg daemon $DAEMON
		modreg file $DAEMON svcs "$(lang de:"Dienste" en:"Services")" 0 "stunnel_svcs"
		modreg file $DAEMON key "$(lang de:"Privater Schlüssel" en:"Own Private Key")" 0 "stunnel_key"
		modreg file $DAEMON certchain "$(lang de:"Zertifikats-Kette" en:"Own Certificate Chain")" 0 "stunnel_certchain"

		modlib_start $STUNNEL_ENABLED
		;;
	unload)
		modunreg file $DAEMON
		modunreg daemon $DAEMON
		modunreg cgi $DAEMON
		modlib_stop
		;;
	start)
		modlib_start
		;;
	stop)
		modlib_stop
		;;
	restart)
		modlib_restart
		;;
	status)
		modlib_status
		;;
	*)
		echo "Usage: $0 [load|unload|start|stop|restart|status]" 1>&2
		exit 1
		;;
esac

exit 0
