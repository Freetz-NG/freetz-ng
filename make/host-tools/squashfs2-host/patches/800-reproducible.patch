+static int parse_num_unsigned(char *arg, unsigned int *res)
+{
+	char *end;
+	unsigned long long number;
+
+	if(!isdigit((unsigned char) arg[0]))
+		return FALSE;
+	errno = 0;
+	number = strtoull(arg, &end, 10);
+	if(errno || *end || number > UINT_MAX)
+		return FALSE;
+	*res = (unsigned int) number;
+	return TRUE;
+}
+
+
+static void check_env_var()
+{
+	char *time_string = getenv("SOURCE_DATE_EPOCH");
+	unsigned int time;
+
+	if(time_string == NULL)
+		return;
+	if(mkfs_time_opt || all_time_opt)
+		BAD_ERROR("SOURCE_DATE_EPOCH and command line options can't be "
+			"used at the same time to set timestamp(s)\n");
+	if(!parse_num_unsigned(time_string, &time))
+		BAD_ERROR("Env Var SOURCE_DATE_EPOCH has invalid time value\n");
+	all_time = mkfs_time = time;
+	all_time_opt = mkfs_time_opt = TRUE;
+}
