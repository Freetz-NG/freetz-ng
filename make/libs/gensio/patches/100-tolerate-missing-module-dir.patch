fix lib install hook when no dynamic modules are built

gensiolibexecdir (moduleinstalldir/PACKAGE_VERSION) is only created as a
side effect of installing the dynamic module libraries.  Builds that
fold every gensio into the main library (e.g. --with-all-gensios=yes)
produce no modules at all, so the directory never exists and the
unconditional cd below aborts install-exec-hook.  Guard it.

--- a/lib/Makefile.am
+++ b/lib/Makefile.am
@@ -391,8 +391,10 @@
 endif
 
 install-exec-hook:
-	@(cd $(DESTDIR)$(gensiolibexecdir) && $(RM) -f $(gensiolibexec_LTLIBRARIES))
-	@(cd $(DESTDIR)$(gensiolibexecdir) && $(RM) -f $(xgensio_libs))
+	@if test -d "$(DESTDIR)$(gensiolibexecdir)"; then \
+		cd "$(DESTDIR)$(gensiolibexecdir)" && $(RM) -f $(gensiolibexec_LTLIBRARIES); \
+		cd "$(DESTDIR)$(gensiolibexecdir)" && $(RM) -f $(xgensio_libs); \
+	fi
 
 # Since we remove the bogus .la and .a files above at install time,
 # libtool will not remove the .so or .dll files since the .la file is

