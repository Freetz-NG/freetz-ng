	a1|mipsel)	shift ; a1="a1" a2=""   a3=""   a4=""   a5=""   a6=""    ;;
	a2|mips)	shift ; a1=""   a2="a2" a3=""   a4=""   a5=""   a6=""    ;;
	a3|x86)		shift ; a1=""   a2=""   a3="a3" a4=""   a5=""   a6=""    ;;
	a4|arm)		shift ; a1=""   a2=""   a3=""   a4="a4" a5=""   a6=""    ;;
	a5|armeb)	shift ; a1=""   a2=""   a3=""   a4=""   a5="a5" a6=""    ;;
	a6|aarch64)	shift ; a1=""   a2=""   a3=""   a4=""   a5=""   a6="a6"  ;;
	*)		        a1="a1" a2="a2" a3="a3" a4="a4" a5="a5" a6="a6"  ;;
esac

case "$2" in
	a|all|"")	old="old" new="new"       ;;
	o|old)		old="old" new=""          ;;
	n|new)		old=""    new="new"       ;;
	*)		shift ; dltc "$*"; exit 0 ;;
esac


